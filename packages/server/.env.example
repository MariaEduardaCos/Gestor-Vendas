# Copie para .env e ajuste.
DATABASE_URL="file:./dev.db"

# As variáveis abaixo vêm do ambiente (shell, serviço de hospedagem), não deste arquivo.
# NODE_ENV=development libera a conta de demonstração e um segredo de sessão padrão
# (os scripts "npm run dev" e o launch.json já definem isso).
# Sem NODE_ENV (ou production), o servidor exige SESSION_SECRET e esconde a conta de demonstração.

# Obrigatório fora do desenvolvimento. Gere com: openssl rand -base64 48
# SESSION_SECRET=

# Origens aceitas pelo CORS em produção, separadas por vírgula (vazio = só a própria origem).
# CORS_ORIGINS=https://minha-revenda.exemplo.com.br

# Força a conta de demonstração fora do desenvolvimento (ex.: apresentação). Use com cuidado.
# ALLOW_DEV_SESSION=1
