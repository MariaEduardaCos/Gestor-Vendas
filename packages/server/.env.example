# Copie para .env e ajuste.
# PostgreSQL local (npm run db:local na raiz). No Render, use o endereço do Supabase (ver docs/DEPLOY.md).
DATABASE_URL="postgresql://postgres@127.0.0.1:5433/consultorasync"

# As variáveis abaixo vêm do ambiente (shell, serviço de hospedagem), não deste arquivo.
# NODE_ENV=development libera a conta de demonstração e um segredo de sessão padrão
# (os scripts "npm run dev" e o launch.json já definem isso).
# Sem NODE_ENV (ou production), o servidor exige SESSION_SECRET e esconde a conta de demonstração.

# Obrigatório fora do desenvolvimento. Gere com: openssl rand -base64 48
# SESSION_SECRET=

# Origens aceitas pelo CORS em produção, separadas por vírgula (vazio = só a própria origem).
# CORS_ORIGINS=https://minha-revenda.exemplo.com.br

# Força a conta de demonstração fora do desenvolvimento (ex.: apresentação). Use com cuidado.
# ALLOW_DEV_SESSION=1

# --- Pesquisa online de produto pelo código de barras (opcional) ---
# Estas quatro variáveis também são lidas deste arquivo .env.
# Sem nenhum token, a pesquisa usa só a Open Beauty Facts (aberta; nome e foto, sem preço).
# Cosmos Bluesoft: nome, marca, PREÇO MÉDIO e foto. Conta gratuita em https://cosmos.bluesoft.com.br
# COSMOS_TOKEN=
# SI5 Global: nome, marca e foto. Conta gratuita em https://global.si5.com.br
# SI5_TOKEN=
# Desligar a Open Beauty Facts: OPEN_BEAUTY_FACTS=0
# Desligar a pesquisa online inteira: CONSULTA_ONLINE=0
