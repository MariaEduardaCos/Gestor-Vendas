datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Operacao {
  id        String   @id
  nome      String
  criado_em DateTime @default(now())

  operadores       Operador[]
  registros_audit  RegistroAuditoria[]
  recursos_exemplo RecursoExemplo[]
  clientes         Cliente[]
  contas           Conta[]
  encomendas       Encomenda[]
  marcas           Marca[]
  produtos         Produto[]
  itens_estoque    EstoqueItem[]
  movimentacoes_estoque MovimentacaoEstoque[]
  itens_conta      ItemConta[]
  compras_marca    CompraMarca[]
  itens_compra_marca ItemCompraMarca[]
  registros_idempotencia RegistroIdempotencia[]
  pagamentos_conta PagamentoConta[]
  excedentes_pendentes ExcedentePendente[]

  @@map("operacoes")
}

model Operador {
  id          String   @id
  operacao_id String
  nome        String
  pin_hash    String?
  ativo       Boolean  @default(true)
  criado_em   DateTime @default(now())

  operacao        Operacao            @relation(fields: [operacao_id], references: [id], onDelete: Cascade)
  registros_audit RegistroAuditoria[]

  @@index([operacao_id])
  @@map("operadores")
}

model RegistroAuditoria {
  id            String   @id
  operacao_id   String
  operador_id   String
  operador_nome String
  acao          String
  detalhes      String?
  criado_em     DateTime @default(now())

  operacao Operacao @relation(fields: [operacao_id], references: [id], onDelete: Cascade)
  operador Operador @relation(fields: [operador_id], references: [id], onDelete: Restrict)

  @@index([operacao_id])
  @@index([operador_id])
  @@map("registros_auditoria")
}

model RecursoExemplo {
  id          String   @id
  operacao_id String
  titulo      String
  descricao   String?
  criado_em   DateTime @default(now())

  operacao Operacao @relation(fields: [operacao_id], references: [id], onDelete: Cascade)

  @@index([operacao_id])
  @@map("recursos_exemplo")
}

model Cliente {
  id                     String   @id
  operacao_id            String
  nome                   String
  telefone               String?
  endereco               String?
  saldo_credito_centavos Int      @default(0)
  criado_em              DateTime @default(now())
  atualizado_em          DateTime @updatedAt

  operacao   Operacao    @relation(fields: [operacao_id], references: [id], onDelete: Cascade)
  contas     Conta[]
  encomendas Encomenda[]
  itens_compra_marca ItemCompraMarca[]
  excedentes ExcedentePendente[]

  @@index([operacao_id])
  @@index([operacao_id, nome])
  @@index([operacao_id, telefone])
  @@map("clientes")
}

model Conta {
  id           String   @id
  operacao_id  String
  cliente_id   String
  encomenda_id String?
  valor_total  Int      @default(0)
  total_pago   Int      @default(0)
  status       String   @default("ABERTA")
  criado_em    DateTime @default(now())

  cliente    Cliente             @relation(fields: [cliente_id], references: [id], onDelete: Restrict)
  operacao   Operacao            @relation(fields: [operacao_id], references: [id], onDelete: Cascade)
  encomenda  Encomenda?          @relation(fields: [encomenda_id], references: [id], onDelete: SetNull)
  itens      ItemConta[]
  pagamentos PagamentoConta[]
  excedentes ExcedentePendente[]

  @@index([operacao_id])
  @@index([cliente_id])
  @@index([encomenda_id])
  @@map("contas")
}

model Encomenda {
  id          String   @id
  operacao_id String
  cliente_id  String
  descricao   String?
  status      String   @default("AGUARDANDO_FABRICA")
  criado_em   DateTime @default(now())

  cliente            Cliente           @relation(fields: [cliente_id], references: [id], onDelete: Restrict)
  operacao           Operacao          @relation(fields: [operacao_id], references: [id], onDelete: Cascade)
  contas             Conta[]
  itens              ItemConta[]
  itens_compra_marca ItemCompraMarca[]

  @@index([operacao_id])
  @@index([cliente_id])
  @@map("encomendas")
}

model ItemConta {
  id                      String   @id
  operacao_id             String
  conta_id                String
  encomenda_id            String?
  produto_id              String
  quantidade              Int
  preco_unitario_centavos  Int
  custo_unitario_centavos  Int?
  origem_custo            String   @default("DESCONHECIDO")
  status_entrega          String   @default("AGUARDANDO_FABRICA")
  criado_em               DateTime @default(now())
  atualizado_em           DateTime @updatedAt

  operacao  Operacao   @relation(fields: [operacao_id], references: [id], onDelete: Cascade)
  conta     Conta      @relation(fields: [conta_id], references: [id], onDelete: Cascade)
  encomenda Encomenda? @relation(fields: [encomenda_id], references: [id], onDelete: SetNull)
  produto   Produto    @relation(fields: [produto_id], references: [id], onDelete: Restrict)

  @@index([operacao_id])
  @@index([conta_id])
  @@index([encomenda_id])
  @@index([produto_id])
  @@map("itens_conta")
}

model Marca {
  id                String   @id
  operacao_id       String
  nome              String
  percentual_padrao Float?
  /// Último catálogo (ciclo/campanha da revista) carregado para esta marca
  catalogo_ciclo         String?
  catalogo_atualizado_em DateTime?
  criado_em         DateTime @default(now())
  atualizado_em     DateTime @updatedAt

  operacao      Operacao      @relation(fields: [operacao_id], references: [id], onDelete: Cascade)
  produtos      Produto[]
  compras_marca CompraMarca[]

  @@index([operacao_id])
  @@index([operacao_id, nome])
  @@map("marcas")
}

model Produto {
  id                   String   @id
  operacao_id          String
  marca_id             String?
  nome                 String
  variante             String?
  codigo_barras        String?
  preco_venda_centavos Int
  custo_centavos       Int?
  proveniencia_custo   String   @default("DESCONHECIDO")
  /// Ciclo do catálogo da marca em que o produto apareceu por último
  ciclo_catalogo       String?
  criado_em            DateTime @default(now())
  atualizado_em        DateTime @updatedAt

  operacao              Operacao              @relation(fields: [operacao_id], references: [id], onDelete: Cascade)
  marca                 Marca?                @relation(fields: [marca_id], references: [id], onDelete: SetNull)
  itens_estoque         EstoqueItem[]
  movimentacoes_estoque MovimentacaoEstoque[]
  itens_conta           ItemConta[]
  itens_compra_marca    ItemCompraMarca[]

  @@index([operacao_id])
  @@index([operacao_id, codigo_barras])
  @@index([operacao_id, nome])
  @@index([marca_id])
  @@map("produtos")
}

model EstoqueItem {
  id             String   @id
  operacao_id    String
  produto_id     String
  presentes      Int      @default(0)
  reservados     Int      @default(0)
  pronta_entrega Int      @default(0)
  criado_em      DateTime @default(now())
  atualizado_em  DateTime @updatedAt

  operacao      Operacao              @relation(fields: [operacao_id], references: [id], onDelete: Cascade)
  produto       Produto               @relation(fields: [produto_id], references: [id], onDelete: Cascade)
  movimentacoes MovimentacaoEstoque[]

  @@unique([operacao_id, produto_id])
  @@index([operacao_id])
  @@index([operacao_id, produto_id])
  @@index([produto_id])
  @@map("itens_estoque")
}

model MovimentacaoEstoque {
  id                      String   @id
  operacao_id             String
  produto_id              String
  estoque_item_id         String
  tipo                    String
  quantidade              Int
  presentes_anterior      Int
  presentes_posterior     Int
  reservados_anterior     Int
  reservados_posterior    Int
  pronta_entrega_anterior  Int
  pronta_entrega_posterior Int
  compra_id               String?
  operador_id             String
  operador_nome           String
  detalhes                String?
  criado_em               DateTime @default(now())

  operacao     Operacao    @relation(fields: [operacao_id], references: [id], onDelete: Cascade)
  produto      Produto     @relation(fields: [produto_id], references: [id], onDelete: Cascade)
  estoque_item EstoqueItem @relation(fields: [estoque_item_id], references: [id], onDelete: Cascade)

  @@index([operacao_id])
  @@index([operacao_id, produto_id])
  @@index([estoque_item_id])
  @@map("movimentacoes_estoque")
}

model CompraMarca {
  id            String   @id
  operacao_id   String
  marca_id      String
  numero_pedido String?
  observacoes   String?
  status        String   @default("PEDIDO_REGISTRADO")
  data_pedido   DateTime @default(now())
  criado_em     DateTime @default(now())
  atualizado_em DateTime @updatedAt

  operacao Operacao          @relation(fields: [operacao_id], references: [id], onDelete: Cascade)
  marca    Marca             @relation(fields: [marca_id], references: [id], onDelete: Restrict)
  itens    ItemCompraMarca[]

  @@index([operacao_id])
  @@index([marca_id])
  @@index([operacao_id, status])
  @@map("compras_marca")
}

model ItemCompraMarca {
  id                      String   @id
  operacao_id             String
  compra_id               String
  produto_id              String
  destinacao              String // "CLIENTE" | "PRONTA_ENTREGA"
  quantidade              Int
  quantidade_recebida     Int      @default(0)
  quantidade_cancelada_falta Int   @default(0)
  cliente_id              String?
  encomenda_id            String?
  item_conta_id           String?
  custo_unitario_centavos  Int?
  origem_custo            String   @default("DESCONHECIDO")
  criado_em               DateTime @default(now())
  atualizado_em           DateTime @updatedAt

  operacao  Operacao    @relation(fields: [operacao_id], references: [id], onDelete: Cascade)
  compra    CompraMarca @relation(fields: [compra_id], references: [id], onDelete: Cascade)
  produto   Produto     @relation(fields: [produto_id], references: [id], onDelete: Restrict)
  cliente   Cliente?    @relation(fields: [cliente_id], references: [id], onDelete: SetNull)
  encomenda Encomenda?  @relation(fields: [encomenda_id], references: [id], onDelete: SetNull)

  @@index([operacao_id])
  @@index([compra_id])
  @@index([produto_id])
  @@index([cliente_id])
  @@index([encomenda_id])
  @@map("itens_compra_marca")
}

model RegistroIdempotencia {
  id            String   @id
  operacao_id   String
  chave         String
  recurso       String
  status_code   Int
  resposta_json String
  criado_em     DateTime @default(now())

  operacao Operacao @relation(fields: [operacao_id], references: [id], onDelete: Cascade)

  @@unique([operacao_id, chave])
  @@index([operacao_id])
  @@index([operacao_id, chave])
  @@map("registros_idempotencia")
}

model PagamentoConta {
  id                     String    @id
  operacao_id            String
  conta_id               String
  valor_pago_centavos    Int
  taxa_cartao_centavos   Int       @default(0)
  valor_liquido_centavos Int
  forma_pagamento        String    // "DINHEIRO" | "PIX" | "CARTAO" | "CREDITO_CARTEIRA"
  data_pagamento         DateTime  @default(now())
  status                 String    @default("CONFIRMADO") // "CONFIRMADO" | "ESTORNADO"
  motivo_estorno         String?
  estornado_em           DateTime?
  estornado_por          String?
  operador_id            String
  operador_nome          String
  criado_em              DateTime  @default(now())

  operacao Operacao @relation(fields: [operacao_id], references: [id], onDelete: Cascade)
  conta    Conta    @relation(fields: [conta_id], references: [id], onDelete: Cascade)

  @@index([operacao_id])
  @@index([conta_id])
  @@index([operacao_id, conta_id])
  @@map("pagamentos_conta")
}

model ExcedentePendente {
  id               String    @id
  operacao_id      String
  conta_id         String
  cliente_id       String
  valor_centavos   Int
  origem           String    // "CANCELAMENTO_ITEM" | "FALTA_FABRICA"
  status           String    @default("PENDENTE") // "PENDENTE" | "DEVOLVIDO_DINHEIRO" | "CONVERTIDO_CREDITO"
  resolvido_em     DateTime?
  motivo_resolucao String?
  operador_id      String
  operador_nome    String
  criado_em        DateTime  @default(now())

  operacao Operacao @relation(fields: [operacao_id], references: [id], onDelete: Cascade)
  conta    Conta    @relation(fields: [conta_id], references: [id], onDelete: Cascade)
  cliente  Cliente  @relation(fields: [cliente_id], references: [id], onDelete: Cascade)

  @@index([operacao_id])
  @@index([cliente_id])
  @@index([conta_id])
  @@index([operacao_id, status])
  @@map("excedentes_pendentes")
}



