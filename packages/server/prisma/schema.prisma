datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Operacao {
  id        String   @id
  nome      String
  criado_em DateTime @default(now())

  operadores       Operador[]
  registros_audit  RegistroAuditoria[]
  recursos_exemplo RecursoExemplo[]
  clientes         Cliente[]
  contas           Conta[]
  encomendas       Encomenda[]
  marcas           Marca[]
  produtos         Produto[]

  @@map("operacoes")
}

model Operador {
  id          String   @id
  operacao_id String
  nome        String
  pin_hash    String?
  ativo       Boolean  @default(true)
  criado_em   DateTime @default(now())

  operacao        Operacao            @relation(fields: [operacao_id], references: [id], onDelete: Cascade)
  registros_audit RegistroAuditoria[]

  @@index([operacao_id])
  @@map("operadores")
}

model RegistroAuditoria {
  id            String   @id
  operacao_id   String
  operador_id   String
  operador_nome String
  acao          String
  detalhes      String?
  criado_em     DateTime @default(now())

  operacao Operacao @relation(fields: [operacao_id], references: [id], onDelete: Cascade)
  operador Operador @relation(fields: [operador_id], references: [id], onDelete: Restrict)

  @@index([operacao_id])
  @@index([operador_id])
  @@map("registros_auditoria")
}

model RecursoExemplo {
  id          String   @id
  operacao_id String
  titulo      String
  descricao   String?
  criado_em   DateTime @default(now())

  operacao Operacao @relation(fields: [operacao_id], references: [id], onDelete: Cascade)

  @@index([operacao_id])
  @@map("recursos_exemplo")
}

model Cliente {
  id                     String   @id
  operacao_id            String
  nome                   String
  telefone               String?
  endereco               String?
  saldo_credito_centavos Int      @default(0)
  criado_em              DateTime @default(now())
  atualizado_em          DateTime @updatedAt

  operacao   Operacao    @relation(fields: [operacao_id], references: [id], onDelete: Cascade)
  contas     Conta[]
  encomendas Encomenda[]

  @@index([operacao_id])
  @@index([operacao_id, nome])
  @@index([operacao_id, telefone])
  @@map("clientes")
}

model Conta {
  id          String   @id
  operacao_id String
  cliente_id  String
  valor_total Int      @default(0)
  total_pago  Int      @default(0)
  status      String   @default("ABERTA")
  criado_em   DateTime @default(now())

  cliente  Cliente  @relation(fields: [cliente_id], references: [id], onDelete: Restrict)
  operacao Operacao @relation(fields: [operacao_id], references: [id], onDelete: Cascade)

  @@index([operacao_id])
  @@index([cliente_id])
  @@map("contas")
}

model Encomenda {
  id          String   @id
  operacao_id String
  cliente_id  String
  descricao   String?
  status      String   @default("AGUARDANDO_FABRICA")
  criado_em   DateTime @default(now())

  cliente  Cliente  @relation(fields: [cliente_id], references: [id], onDelete: Restrict)
  operacao Operacao @relation(fields: [operacao_id], references: [id], onDelete: Cascade)

  @@index([operacao_id])
  @@index([cliente_id])
  @@map("encomendas")
}

model Marca {
  id                String   @id
  operacao_id       String
  nome              String
  percentual_padrao Float?
  criado_em         DateTime @default(now())
  atualizado_em     DateTime @updatedAt

  operacao Operacao  @relation(fields: [operacao_id], references: [id], onDelete: Cascade)
  produtos Produto[]

  @@index([operacao_id])
  @@index([operacao_id, nome])
  @@map("marcas")
}

model Produto {
  id                   String   @id
  operacao_id          String
  marca_id             String?
  nome                 String
  variante             String?
  codigo_barras        String?
  preco_venda_centavos Int
  custo_centavos       Int?
  proveniencia_custo   String   @default("DESCONHECIDO")
  criado_em            DateTime @default(now())
  atualizado_em        DateTime @updatedAt

  operacao Operacao @relation(fields: [operacao_id], references: [id], onDelete: Cascade)
  marca    Marca?   @relation(fields: [marca_id], references: [id], onDelete: SetNull)

  @@index([operacao_id])
  @@index([operacao_id, codigo_barras])
  @@index([operacao_id, nome])
  @@index([marca_id])
  @@map("produtos")
}

